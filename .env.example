# Firebase server-side configuration
# Never commit the real service-account JSON or real secrets.

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_CREDENTIALS=/absolute/path/to/firebase_credentials.json

# Internal email namespace used to preserve the POS username UI.
# Example: cashier01 becomes cashier01@your-project.firebaseapp.com
FIREBASE_AUTH_EMAIL_DOMAIN=your-firebase-project.firebaseapp.com
